APP_NAME="OJS System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://domain-anda.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# LOGGING - Minimal error for production to save space
LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# DATABASE - Gunakan MySQL / PostgreSQL (Jangan SQLite untuk production)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ojs_production
DB_USERNAME=root
DB_PASSWORD=secret_password_anda

# SESSION - Gunakan database atau redis agar aman
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log

# FILESYSTEM - Pastikan public storage telah di-link (php artisan storage:link)
FILESYSTEM_DISK=local

# QUEUE - Penting untuk background job (email, dll)
QUEUE_CONNECTION=database

# CACHE - Gunakan redis, memcached, atau file
CACHE_STORE=file

# REDIS (Opsional jika Anda menggunakan redis untuk cache/queue/session)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# MAIL - Tidak perlu diisi di sini karena sudah di-handle oleh database (Tabel api_integrations via UI Admin)
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@domain-anda.com"
MAIL_FROM_NAME="${APP_NAME}"

# AWS S3 (Opsional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
